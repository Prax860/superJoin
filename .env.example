# Backend
# Reasoning provider for fact extraction and comparison: groq | gemini
# LLM_PROVIDER=groq
# GROQ_API_KEY=

# # Gemini is always used for embeddings (Groq has no embeddings API)
# GEMINI_API_KEY=

# SUPABASE_URL=
# SUPABASE_KEY=

# # Frontend
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional overrides
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_PROVIDER=gemini        # set to 'ollama' for a fully offline setup
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# GROQ_MODEL=openai/gpt-oss-120b   (also available: qwen/qwen3.6-27b, openai/gpt-oss-20b)
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
