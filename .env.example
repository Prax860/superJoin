# ---------- Backend ----------

# Which provider does the reasoning (fact extraction + comparison):
#   ollama | groq | openai | gemini
# Only the selected provider's key is required.
LLM_PROVIDER=ollama

# ollama: local, free, no key. Needs the Ollama app running.
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# groq: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# openai: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

SUPABASE_URL=
SUPABASE_KEY=

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Optional ----------
# Embeddings always run locally, independently of LLM_PROVIDER.
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# EMBEDDING_DIM=768            # must match vector(N) in schema.sql
# LLM_MAX_TOKENS=900           # output cap per call; 0 = no cap
